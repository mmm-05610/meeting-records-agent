# meeting-records-agent —— Web 服务端环境变量示例
#
# 复制为 apps/web/.env.local 后按需修改。
# 这些变量只在 Node 服务端读取；严禁使用 NEXT_PUBLIC_* 前缀，
# 否则浏览器会拿到 R2R / Agent 地址与凭据（违反 C05 与 T012）。
#
# 注意：apps/web/.gitignore 目前用 `.env*` 忽略全部 env 文件，
# 提交本示例时需要加一行 `!.env.local.example`。

# R2R 检索服务地址（本地默认）
R2R_API_URL=http://127.0.0.1:7272

# Agent 服务地址（本地默认）
AGENT_API_URL=http://127.0.0.1:8080

# 本地单账号管理员凭据：仅服务端用于登录 R2R 换取 token，不下发浏览器。
# 与根 .env 中的 R2R_ADMIN_EMAIL / R2R_ADMIN_PASSWORD 保持一致；首次启动前替换占位值。
R2R_ADMIN_EMAIL=owner@meeting-records.local
R2R_ADMIN_PASSWORD=change-me

# 会话 Cookie 签名密钥（必填，至少 16 位）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MRA_SESSION_SECRET=change-me-to-a-random-32-byte-secret

# 会话有效期（秒）。默认 3600，且不会超过 R2R access token 的有效期。
MRA_SESSION_TTL_SECONDS=3600

# 单次 R2R / Agent 请求超时（毫秒）。超时按 C08 归为 unknown_result。
MRA_UPSTREAM_TIMEOUT_MS=120000

# 单次上传体积上限（字节）。默认 32 MiB。
MRA_MAX_UPLOAD_BYTES=33554432

# AG-UI 流式运行超时（毫秒）。默认 15 分钟。
MRA_AGUI_TIMEOUT_MS=900000
