# meeting-records-agent v0.1 local configuration (copy to .env, never commit .env)
#
# Generation endpoint (opencode-go). Embeddings run locally in the model gateway;
# no external embedding key is required.
OPENCODE_GO_API_KEY=
GATEWAY_PORT=8081
GATEWAY_UPSTREAM_BASE=https://opencode.ai/zen/go/v1
GATEWAY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
GATEWAY_EMBEDDING_DIM=512

# R2R document service
R2R_PORT=7272
R2R_HOST=127.0.0.1
R2R_PROJECT_NAME=meeting_records_agent
R2R_SECRET_KEY=change-me
R2R_ADMIN_EMAIL=owner@meeting-records.local
R2R_ADMIN_PASSWORD=change-me
R2R_POSTGRES_USER=rag_app
R2R_POSTGRES_PASSWORD=change-me
R2R_POSTGRES_HOST=127.0.0.1
R2R_POSTGRES_PORT=55432
R2R_POSTGRES_DBNAME=rag_db
R2R_USER_TOOLS_PATH=
# R2R embedding calls go to the local gateway through an OpenAI-compatible API.
OPENAI_API_KEY=local-gateway
OPENAI_API_BASE=http://127.0.0.1:8081/v1
LITELLM_DROP_PARAMS=True

# Agent service
DEFAULT_MODEL=openai-compatible
COMPATIBLE_BASE_URL=http://127.0.0.1:8081/v1
COMPATIBLE_API_KEY=local-gateway
COMPATIBLE_MODEL=deepseek-v4.1-flash
DATABASE_TYPE=postgres
POSTGRES_USER=agent_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=agent_db
R2R_BASE_URL=http://127.0.0.1:7272
R2R_SERVICE_EMAIL=owner@meeting-records.local
R2R_SERVICE_PASSWORD=change-me
MEETING_MODEL_LABEL=gateway/deepseek-v4.1-flash
MEETING_RERANK_BACKEND=fastembed
MEETING_RERANK_MODEL=BAAI/bge-reranker-base
MEETING_RERANK_CACHE_DIR=./data/flashrank
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Web (also set in apps/web/.env.local; see apps/web/.env.local.example)
MRA_SESSION_SECRET=
