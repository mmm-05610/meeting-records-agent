# Copy to deployment/env/local.env and fill in. Never commit the filled file.
# Container-only variables; native mode uses the repository root .env instead.
POSTGRES_SUPERUSER_PASSWORD=change-me
RAG_DB_PASSWORD=change-me
AGENT_DB_PASSWORD=change-me
R2R_SECRET_KEY=change-me
R2R_ADMIN_EMAIL=owner@meeting-records.local
R2R_ADMIN_PASSWORD=change-me
MRA_SESSION_SECRET=change-me-32-bytes-hex
OPENCODE_GO_API_KEY=sk-...
COMPATIBLE_MODEL=deepseek-v4.1-flash
GATEWAY_UPSTREAM_BASE=https://opencode.ai/zen/go/v1
GATEWAY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEETING_RERANK_BACKEND=fastembed
MEETING_RERANK_MODEL=BAAI/bge-reranker-base
MRA_UPSTREAM_TIMEOUT_MS=120000
MRA_AGUI_TIMEOUT_MS=900000

